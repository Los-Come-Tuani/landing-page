# Copiar a `.env.local` para desarrollo. Todo `VITE_*` queda dentro del bundle: solo valores
# públicos. Sin estas variables la landing usa los de producción.

# El API: recibe las solicitudes de demo y devuelve los links de la app. En `npm run dev` déjala
# vacía: la landing usa el proxy de Vite (`/_api`) y el navegador no pide CORS. Con una URL
# completa, el CORS_ALLOWED_ORIGINS del API tiene que incluir el dominio de la landing.
VITE_API_URL=

# Solo `npm run dev`: a dónde reenvía el proxy `/_api` (sin definir, develop-api). No lleva
# `VITE_`: no entra al bundle. Para el API local: http://localhost:8080
API_PROXY_TARGET=

# El portal: los negocios se registran en `/postular`.
VITE_PORTAL_URL=https://portal.kplan.dev
